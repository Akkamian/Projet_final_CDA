# Variables de l'API en production (PlanetHoster, voir docs/DEPLOIEMENT.md).
# À renseigner dans l'interface de l'hébergeur (variables d'environnement de l'application Node) :
# ne jamais commiter de valeur réelle. En production main.ts ne lit aucun fichier .env.

NODE_ENV=production

# --- Base de données (PostgreSQL de l'hébergement, accessible en local sur le serveur) ---
DATABASE_URL=postgresql://UTILISATEUR:MOT_DE_PASSE@127.0.0.1:5432/NOM_DE_LA_BASE

# --- API ---
# Passenger fournit lui-même le port : ne renseigner PORT que si l'hébergeur le demande.
# PORT=
# Adresse publique du front (CORS) : exactement l'origine, sans barre finale.
WEB_ORIGIN=https://app.example.com
# Deux secrets distincts, longs et aléatoires (ex. : openssl rand -base64 48).
JWT_SESSION_SECRET=
JWT_LINK_SECRET=
# Obligatoire en production : le cookie de renouvellement n'est envoyé qu'en HTTPS.
COOKIE_SECURE=true
# Tentatives autorisées par IP et par fenêtre (connexion, mot de passe oublié, renvoi du lien).
THROTTLE_LIMIT=5
THROTTLE_TTL_SECONDS=60

# --- Emails (fournisseur à choisir, voir docs/DEPLOIEMENT.md) ---
SMTP_HOST=
SMTP_PORT=587
MAIL_FROM=no-reply@example.com

# --- Photos : stockage objet compatible S3 (le disque de l'hébergement n'est pas utilisé) ---
STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
