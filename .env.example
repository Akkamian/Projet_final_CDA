# Copier ce fichier en .env (jamais commité) et adapter les valeurs.

# --- Base de données (PostgreSQL 16 via docker-compose, port 5435 côté poste) ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5435/watch_tracker
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5435/watch_tracker_test

# --- API ---
PORT=3000
WEB_ORIGIN=http://localhost:5173
JWT_SESSION_SECRET=change-me-session
JWT_LINK_SECRET=change-me-link
COOKIE_SECURE=false
THROTTLE_LIMIT=5
THROTTLE_TTL_SECONDS=60

# --- Emails (MailDev en dev : interface sur http://localhost:1080) ---
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM=no-reply@watch-tracker.local

# --- Photos ---
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Web (lu au build par Vite) ---
VITE_API_URL=http://localhost:3000
